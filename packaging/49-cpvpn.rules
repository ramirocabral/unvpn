// polkit rule for cpvpn — scopes the privileged engine launched via pkexec.
//
// Default below: prompt for the admin password once, then cache it for a few
// minutes (AUTH_ADMIN_KEEP) — secure and convenient. To make connecting fully
// passwordless (less secure), change AUTH_ADMIN_KEEP to YES.
//
// Install to: /etc/polkit-1/rules.d/49-cpvpn.rules   (root:root, 0644)

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/local/bin/cpvpn" &&
        subject.local && subject.active) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});
