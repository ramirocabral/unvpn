// polkit rule for unvpn: whoever sits at the machine starts the engine as root
// through pkexec without a password, the way NetworkManager lets them control
// the network.
//
// Install to: /etc/polkit-1/rules.d/49-unvpn.rules   (root:root, 0644)

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/local/bin/unvpn" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
